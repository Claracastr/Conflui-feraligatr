          "if(!pm.environment.get(\"observationId\")){pm.environment.set(\"observationId\",\"postman-\"+Date.now());}",
          "if(!pm.environment.get(\"passageId\")){pm.environment.set(\"passageId\",\"postman-passage-\"+Date.now());}",
          "if(!pm.environment.get(\"passageStart\")){pm.environment.set(\"passageStart\",new Date(new Date(pm.environment.get(\"capturedAt\")).getTime()-900000).toISOString());}"
        ]
      }
